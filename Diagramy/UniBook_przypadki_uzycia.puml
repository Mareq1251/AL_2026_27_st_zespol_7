@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Gość" as Guest
actor "Użytkownik" as User
actor "Użytkownik\nrezerwujący" as Booker
actor "Student" as Student
actor "Pracownik" as Employee
actor "Administrator" as Admin
actor "Obsługa" as Staff

User <|-- Booker
User <|-- Admin
User <|-- Staff
Booker <|-- Student
Booker <|-- Employee

rectangle "UniBook — system rezerwacji sal i sprzętu" {
  usecase "UC01\nZarejestruj konto" as UC01
  usecase "UC02\nZaloguj się" as UC02
  usecase "UC03\nWyloguj się" as UC03

  usecase "UC04\nPrzeglądaj i filtruj zasoby" as UC04
  usecase "UC05\nSprawdź dostępność zasobu" as UC05
  usecase "UC06\nZłóż rezerwację" as UC06
  usecase "UC07\nEdytuj własną rezerwację" as UC07
  usecase "UC08\nAnuluj własną rezerwację" as UC08
  usecase "UC09\nPrzeglądaj własne rezerwacje\ni ich historię" as UC09

  usecase "UC10\nZarządzaj kontami i rolami" as UC10
  usecase "UC11\nZarządzaj zasobami" as UC11
  usecase "UC12\nZatwierdź rezerwację" as UC12
  usecase "UC13\nOdrzuć rezerwację" as UC13
  usecase "UC14\nPrzeglądaj historię operacji" as UC14

  usecase "UC15\nPrzeglądaj zatwierdzone\nrezerwacje sprzętu" as UC15
  usecase "UC16\nZarejestruj wydanie sprzętu" as UC16
  usecase "UC17\nZarejestruj zwrot sprzętu" as UC17
  usecase "UC18\nPrzeglądaj historię wydań\ni niezwrócony sprzęt" as UC18
}

Guest -- UC01
User -- UC02
User -- UC03

Booker -- UC04
Booker -- UC05
Booker -- UC06
Booker -- UC07
Booker -- UC08
Booker -- UC09

Admin -- UC10
Admin -- UC11
Admin -- UC12
Admin -- UC13
Admin -- UC14

Staff -- UC15
Staff -- UC16
Staff -- UC17
Staff -- UC18

note right of UC06
  Rezerwacje oczekujące i zatwierdzone
  blokują termin dla danego zasobu.
end note

note right of UC13
  Odrzucenie wymaga uzasadnienia.
end note

note right of UC16
  Wydanie wymaga zatwierdzonej rezerwacji
  i braku otwartego wypożyczenia egzemplarza.
end note
@enduml